---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanCard from '../components/PlanCard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import CareCard from '../components/CareCard.astro';
import DiagBand from '../components/DiagBand.astro';
import Reveal from '../components/Reveal.astro';

import { plans } from '../data/plans';
import { modules } from '../data/modules';
import { carePlans, careNote } from '../data/care';
import { faq } from '../data/faq';
import { routes } from '../data/links';
---

<BaseLayout
  title="Planes"
  description="Cuatro planes fijos entre $295 y $1,200. Sistemas grandes por módulos. Mantenimiento mensual con SLA. Cero letra chica."
  activePath={routes.planes}
>
  <!-- HERO -->
  <section class="hero hero-short">
    <div class="container hero-inner">
      <span class="year">Catálogo</span>
      <span class="handle">Rango $49 – $1,200</span>
      <Reveal>
        <h1>Cuatro planes. <span class="muted">Cero letra chica.</span></h1>
      </Reveal>
      <Reveal delay={0.15}>
        <p class="lead">
          Precios fijos, entregas por escrito, código en tu GitHub. Si necesitas algo más
          grande, se cotiza por módulos. Si buscas mantenimiento, tenemos plan mensual.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- PLANES -->
  <section class="planes" id="planes">
    <div class="container">
      <span class="eyebrow">Sitios web</span>
      <h2 class="section-title">Elige un plan. <span class="muted">O escríbenos si dudas.</span></h2>

      <div class="plans-grid">
        {plans.map((plan) => (
          <Reveal>
            <PlanCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <Reveal delay={0.15}>
        <DiagBand />
      </Reveal>
    </div>
  </section>

  <!-- MÓDULOS -->
  <section class="modulos" id="modulos">
    <div class="container">
      <span class="eyebrow">Proyectos grandes</span>
      <h2 class="section-title">
        ¿Necesitas un sistema? <span class="muted">Se vende por módulos.</span>
      </h2>
      <Reveal>
        <p class="modules-intro">
          Un sistema completo no se cotiza en una sola factura. Se arma con módulos combinables:
          pagas y recibes por partes, sin riesgo y sin esperar meses para ver el primer entregable.
        </p>
      </Reveal>

      <div class="modules-grid">
        {modules.map((mod) => (
          <Reveal>
            <ModuleCard module={mod} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CARE -->
  <section class="care" id="care">
    <div class="container">
      <span class="eyebrow">FLASK Care</span>
      <h2 class="section-title">Tu sitio, <span class="muted">cuidado todos los meses.</span></h2>

      <div class="care-grid">
        {carePlans.map((plan) => (
          <Reveal>
            <CareCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <Reveal>
        <div class="care-note">
          <strong>Pago anual adelantado:</strong> {careNote.replace('Pago anual adelantado: ', '')}
        </div>
      </Reveal>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="container">
      <span class="eyebrow">Preguntas</span>
      <h2 class="section-title">Antes de <span class="muted">escribirnos.</span></h2>
      {faq.map((item) => (
        <Reveal>
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>¿Cuál te encaja?</h2>
        <p>Cuéntanos qué necesitas. Te enviamos una propuesta escrita con alcance, cronograma y precio.</p>
        <a class="btn btn-primary" href={routes.contacto}>
          <span class="dot"></span> Escribir a FLASK
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>
