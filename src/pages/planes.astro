---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlanCard from '../components/PlanCard.astro';
import ModuleCard from '../components/ModuleCard.astro';
import CareCard from '../components/CareCard.astro';
import DiagBand from '../components/DiagBand.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';

import { plans, diagnostico } from '../data/plans';
import { modules } from '../data/modules';
import { carePlans, careNote } from '../data/care';
import { faq } from '../data/faq';
import { planVisuals } from '../data/images';
import { routes } from '../data/links';
import { site } from '../data/site';

const origin = Astro.site ?? new URL('http://localhost:4321');
const planesUrl = new URL(routes.planes, origin).toString();

/** El precio va como número: schema.org no acepta "$850". */
const toAmount = (price: string) => Number(price.replace(/[^0-9.]/g, ''));

// Catálogo de servicios: le dice a Google qué vende FLASK y a qué precio.
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Diseño y desarrollo web — ${site.name}`,
  serviceType: 'Diseño y desarrollo de sitios web Jamstack',
  description: site.description,
  areaServed: { '@type': 'Country', name: site.location },
  provider: {
    '@type': 'Organization',
    name: site.name,
    url: new URL(routes.home, origin).toString(),
  },
  offers: [...plans, diagnostico].map((item) => ({
    '@type': 'Offer',
    name: item.name,
    description: item.desc,
    price: toAmount(item.price),
    priceCurrency: 'USD',
    url: planesUrl,
    availability: 'https://schema.org/InStock',
  })),
};

/**
 * Vitrina: los dos extremos del catálogo de sitios. Muestra de dónde parte el
 * rango y hasta dónde llega, con enlace directo al formulario ya preseleccionado.
 */
const showcase = ['start', 'corporate']
  .map((slug) => ({ plan: plans.find((p) => p.slug === slug)!, visual: planVisuals[slug]! }))
  .filter((item) => item.plan && item.visual);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="Planes"
  description="Cuatro planes fijos entre $295 y $1,200. Capacidades avanzadas por separado. Mantenimiento mensual con SLA. Cero letra chica."
  activePath={routes.planes}
  jsonLd={[serviceSchema, faqSchema]}
>
  <!--
    Los precios van primero, sin hero de por medio: quien entra aquí ya sabe qué
    quiere ver. El argumento de venta ("Cuatro planes. Cero letra chica.") pasa
    justo debajo, cuando ya tiene las cifras delante y le sirve de respaldo.
  -->
  <section class="planes" id="planes">
    <div class="container">
      <div class="planes-head">
        <span class="eyebrow">Sitios web · $295 – $1,200</span>
        <h1 class="planes-title">Elige un plan. <span class="muted">O escríbenos si dudas.</span></h1>
      </div>

      <div class="plans-grid">
        {plans.map((plan) => (
          <Reveal>
            <PlanCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <Reveal delay={0.15}>
        <DiagBand />
      </Reveal>
    </div>
  </section>

  <!-- RESPALDO: lo que sostiene esos precios -->
  <section class="promise">
    <div class="container">
      <div class="promise-grid">
        <Reveal>
          <h2 class="promise-title">Cuatro planes. <span class="muted">Cero letra chica.</span></h2>
        </Reveal>
        <div class="promise-facts">
          <Reveal delay={0.1}>
            <div class="promise-fact">
              <span class="promise-k">Precio cerrado</span>
              <p>El número que ves es el que pagas. El alcance va por escrito antes de arrancar y lo que quede fuera se cotiza aparte, sin sorpresas a mitad del proyecto.</p>
            </div>
          </Reveal>
          <Reveal delay={0.18}>
            <div class="promise-fact">
              <span class="promise-k">Plazo cerrado</span>
              <p>Cada plan trae su cronograma. Los días cuentan desde que recibimos tu contenido y el 50 % del pago, no desde una fecha imaginaria.</p>
            </div>
          </Reveal>
          <Reveal delay={0.26}>
            <div class="promise-fact">
              <span class="promise-k">El código es tuyo</span>
              <p>El repositorio se transfiere a tu GitHub al pago final y el dominio queda a tu nombre. Si mañana te vas, te llevas todo.</p>
            </div>
          </Reveal>
        </div>
      </div>
    </div>
  </section>

  <!-- VITRINA: los dos extremos del catálogo, como escenas -->
  {showcase.map(({ plan, visual }, i) => {
    const side = i % 2 === 0 ? 'left' : 'right';
    return (
      <section class="showcase-scene" data-side={side}>
        <SceneBg visual={visual} side={side} dim={0.42} />
        <div class="container">
          <div class="showcase-copy">
            <Reveal>
              <span class="showcase-eyebrow">{i === 0 ? 'El arranque' : 'La operación completa'}</span>
              <h2>{plan.name.replace('Flask ', '')}</h2>
            </Reveal>
            <Reveal delay={0.12}>
              <p class="showcase-desc">{plan.desc}</p>
              <div class="showcase-meta">
                <span class="showcase-price">{plan.price}</span>
                <span class="showcase-delivery">{plan.delivery}</span>
              </div>
              <a class="btn btn-primary" href={`${routes.contacto}?plan=${plan.slug}`}>
                <span class="dot"></span> Cotizar {plan.name.replace('Flask ', '')}
              </a>
            </Reveal>
          </div>
        </div>
      </section>
    );
  })}

  <!-- CAPACIDADES AVANZADAS -->
  <section class="modulos" id="modulos">
    <div class="container">
      <span class="eyebrow">Capacidades avanzadas</span>
      <h2 class="section-title">
        ¿Tu negocio necesita más? <span class="muted">Súmale potencia.</span>
      </h2>
      <Reveal>
        <p class="modules-intro">
          Un sitio no tiene por qué quedarse en un sitio. Cada capacidad de abajo se enchufa a lo
          que ya tienes, con precio cerrado y sin rehacer nada: activas la que necesitas, cuando la
          necesitas. Puedes empezar con una y sumar el resto más adelante.
        </p>
      </Reveal>

      <div class="modules-grid">
        {modules.map((mod, i) => (
          <Reveal>
            <ModuleCard module={mod} idx={i} />
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- CARE -->
  <section class="care" id="care">
    <div class="container">
      <span class="eyebrow">FLASK Care</span>
      <h2 class="section-title">Tu sitio, <span class="muted">cuidado todos los meses.</span></h2>

      <div class="care-grid">
        {carePlans.map((plan) => (
          <Reveal>
            <CareCard plan={plan} />
          </Reveal>
        ))}
      </div>

      <Reveal>
        <div class="care-note">
          <strong>Pago anual adelantado:</strong> {careNote.replace('Pago anual adelantado: ', '')}
        </div>
      </Reveal>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="container">
      <span class="eyebrow">Preguntas</span>
      <h2 class="section-title">Antes de <span class="muted">escribirnos.</span></h2>
      {faq.map((item) => (
        <Reveal>
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>¿Cuál te encaja?</h2>
        <p>Cuéntanos qué necesitas. Te enviamos una propuesta escrita con alcance, cronograma y precio.</p>
        <a class="btn btn-primary" href={routes.contacto}>
          <span class="dot"></span> Escribir a FLASK
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* Sin hero: el nav flotante necesita aire propio arriba */
  .planes {
    padding-top: 168px;
  }
  .planes-head {
    margin-bottom: 54px;
  }
  .planes-title {
    font-size: clamp(38px, 5.6vw, 72px);
    font-weight: 600;
    line-height: 1.0;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 20ch;
  }
  .planes-title .muted {
    color: var(--studio-gray);
  }

  /* ---------- RESPALDO ---------- */
  .promise {
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .promise-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: start;
  }
  .promise-title {
    font-size: clamp(32px, 4.2vw, 56px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .promise-title .muted {
    color: var(--studio-gray);
  }
  .promise-facts {
    display: grid;
    gap: 28px;
  }
  .promise-k {
    display: block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 10px;
  }
  .promise-fact p {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    max-width: 56ch;
  }

  /* ---------- VITRINA ---------- */
  .showcase-scene {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: 110px 0;
    overflow: hidden;
  }
  .showcase-scene .container {
    position: relative;
    z-index: 1;
  }
  .showcase-copy {
    max-width: 44ch;
  }
  .showcase-scene[data-side='right'] .showcase-copy {
    margin-left: auto;
  }
  .showcase-eyebrow {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 18px;
  }
  .showcase-copy h2 {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 22px;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .showcase-desc {
    font-size: 17px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }
  .showcase-meta {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin: 26px 0 30px;
  }
  .showcase-price {
    font-size: 46px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .showcase-delivery {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
  }

  @media (max-width: 900px) {
    .planes {
      padding-top: 140px;
    }
    .promise-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .showcase-scene {
      min-height: 0;
      padding: 84px 0;
    }
    .showcase-scene[data-side='right'] .showcase-copy {
      margin-left: 0;
    }
    .showcase-copy {
      max-width: none;
    }
  }
</style>
