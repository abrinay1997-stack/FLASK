---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import CineFrame from '../components/CineFrame.astro';
import { routes } from '../data/links';
import { site, contact, waLink } from '../data/site';
import { sobreVisuals } from '../data/images';
---

<BaseLayout
  title="Nosotros"
  description={`${site.name} construye sitios rápidos, seguros y entregados en días. Manifiesto y filosofía.`}
  activePath={routes.sobre}
>
  <!-- HERO -->
  <section class="hero hero-short">
    <div class="container hero-inner">
      <span class="year">Nosotros</span>
      <span class="handle">Manifiesto</span>
      <Reveal>
        <h1>El código es <span class="muted">tuyo.</span></h1>
      </Reveal>
      <Reveal delay={0.15}>
        <p class="lead">
          FLASK nace de una frustración concreta: el mercado panameño está saturado de agencias
          que entregan WordPress lento, con panel de administración a su nombre y un código que
          nunca ves. Nosotros hacemos lo opuesto.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- BANDA CINEMÁTICA -->
  <section class="sobre-band">
    <div class="container">
      <Reveal>
        <CineFrame
          visual={sobreVisuals.manifiesto}
          ratio="21 / 8"
          ratioMobile="16 / 11"
          sizes="(max-width: 1360px) calc(100vw - 44px), 1200px"
          widths={[768, 1200, 1800, 2400]}
        />
      </Reveal>
    </div>
  </section>

  <!-- MANIFIESTO -->
  <section class="manifest-section">
    <div class="container">
      <div class="manifest-grid">
        <Reveal>
          <div class="manifest-item">
            <div class="manifest-num">01</div>
            <h3>Velocidad no es lujo.</h3>
            <p>
              Un sitio que carga en cinco segundos pierde el 40 % de sus visitas antes de renderizar.
              Cada milisegundo cuenta. Por eso todo lo que hacemos vive sobre Jamstack y CDN, no
              sobre servidores compartidos con base de datos.
            </p>
          </div>
        </Reveal>

        <Reveal delay={0.1}>
          <div class="manifest-item">
            <div class="manifest-num">02</div>
            <h3>El dueño del código eres tú.</h3>
            <p>
              El repositorio se transfiere a tu GitHub al pago final. El dominio queda a tu nombre.
              Si mañana quieres irte con otra agencia, tu problema — tienes todo. Somos partners,
              no captores.
            </p>
          </div>
        </Reveal>

        <Reveal delay={0.2}>
          <div class="manifest-item">
            <div class="manifest-num">03</div>
            <h3>Precios fijos, por escrito.</h3>
            <p>
              Nada de "consultar por interno". Nada de "depende del cliente". Nuestros paquetes
              tienen precio público, alcance por escrito y cronograma cerrado. El scope creep se
              cotiza aparte, sin resentimiento.
            </p>
          </div>
        </Reveal>

        <Reveal delay={0.3}>
          <div class="manifest-item">
            <div class="manifest-num">04</div>
            <h3>Contra WordPress.</h3>
            <p>
              El 43 % de la web corre WordPress. Compartimos con los que lo mantienen bien la
              admiración por su ecosistema. Pero para PYMES en Panamá que necesitan un sitio que
              funcione sin actualizar plugins cada semana, es la opción equivocada. Nosotros
              usamos lo mejor de 2026.
            </p>
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!--
    Pendiente de contenido del cliente: bio personal, foto profesional y
    credenciales. Hasta que existan, este bloque habla del estudio y de
    compromisos que ya están por escrito en /planes y /proceso — nada inventado.
  -->
  <section class="who-section">
    <div class="container">
      <Reveal>
        <span class="eyebrow">Quiénes</span>
        <h2 class="section-title">
          Detrás de <span class="muted">FLASK.</span>
        </h2>
      </Reveal>

      <div class="who-grid">
        <Reveal>
          <div class="who-body">
            <p class="who-lead">
              FLASK es un estudio pequeño, no una fábrica de sitios. Hablas directo con quien
              programa tu proyecto: sin ejecutivos de cuenta, sin intermediarios traduciendo lo
              que quieres, sin tickets que tardan una semana en llegar a la persona correcta.
            </p>

            <dl class="who-facts">
              <div>
                <dt>Stack</dt>
                <dd>
                  Astro y arquitectura Jamstack sobre CDN. Supabase cuando el sitio necesita CMS
                  o base de datos. Deploy continuo desde GitHub. Sin WordPress, sin plugins que
                  actualizar cada semana.
                </dd>
              </div>
              <div>
                <dt>Compromisos</dt>
                <dd>
                  Precio fijo por escrito antes de arrancar, rondas de revisión definidas por
                  plan, repositorio transferido a tu GitHub al pago final y dominio a tu nombre.
                  Está en la propuesta, no en la conversación.
                </dd>
              </div>
              <div>
                <dt>Cómo trabajamos</dt>
                <dd>
                  100 % remoto para todo {site.location}. Coordinación por WhatsApp en horario
                  laboral ({contact.horario}) y entregas parciales para que veas avances desde
                  los primeros días, no una sorpresa al final.
                </dd>
              </div>
            </dl>

            <a class="btn btn-ghost" href={waLink('Hola FLASK, quiero hablar de mi proyecto')} target="_blank" rel="noopener">
              Hablar con quien programa
            </a>
          </div>
        </Reveal>

        <Reveal delay={0.15}>
          <CineFrame
            class="who-visual"
            visual={sobreVisuals.interfaz}
            ratio="4 / 5"
            ratioMobile="16 / 10"
            sizes="(max-width: 900px) calc(100vw - 44px), 40vw"
          />
        </Reveal>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>¿Trabajamos juntos?</h2>
        <p>Si compartes esta forma de ver la web, escríbenos. Empecemos con una cotización.</p>
        <a class="btn btn-primary" href={routes.contacto}>
          <span class="dot"></span> Contacto
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .manifest-section {
    padding: 80px 0 100px;
  }
  .manifest-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .manifest-item {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 22px;
    padding: 40px 34px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, background 0.25s;
  }
  .manifest-item:hover {
    border-color: var(--flash-orange);
    background: rgba(255, 81, 0, 0.04);
  }
  .manifest-num {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 20px;
  }
  .manifest-item h3 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }
  .manifest-item p {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
  }
  .sobre-band {
    padding: 20px 0 0;
  }
  .who-section {
    padding: 80px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .who-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 60px;
    align-items: start;
  }
  .who-lead {
    font-size: 20px;
    color: var(--soft-white);
    line-height: 1.45;
    max-width: 46ch;
  }
  .who-facts {
    margin: 36px 0 34px;
    display: grid;
    gap: 26px;
  }
  .who-facts dt {
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 10px;
  }
  .who-facts dd {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    max-width: 58ch;
  }
  /* :global() porque la raíz de <CineFrame> no lleva el scope de esta página */
  .who-grid :global(.who-visual) {
    max-height: 620px;
  }
  @media (max-width: 900px) {
    .manifest-grid {
      grid-template-columns: 1fr;
    }
    .who-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
    .who-grid :global(.who-visual) {
      max-height: 340px;
    }
  }
</style>
