---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';
import { routes } from '../data/links';
import { site, contact, waLink } from '../data/site';
import { sobreVisuals } from '../data/images';

/**
 * Manifiesto en formato titular + una línea. La versión larga anterior se leía
 * como un ensayo; esto se escanea en diez segundos, que es lo que dura de
 * verdad la atención en una página "nosotros".
 */
const manifiesto = [
  {
    num: '01',
    title: 'Cinco segundos de carga es una fuga.',
    line: 'Cuatro de cada diez visitas se van antes de ver tu sitio. No es estética: es dinero saliendo por la puerta.',
  },
  {
    num: '02',
    title: 'Tu sitio no debería ser rehén de nadie.',
    line: 'El repositorio se transfiere a tu GitHub y el dominio queda a tu nombre. Si te vas, te llevas todo.',
  },
  {
    num: '03',
    title: 'El precio va por escrito. Siempre.',
    line: 'Nada de "consultar por interno". Alcance, cronograma y cifra cerrada antes de la primera línea de código.',
  },
  {
    num: '04',
    title: 'WordPress no es el default. Es una decisión.',
    line: 'Y para una PYME que solo quiere un sitio que funcione, casi siempre es la decisión equivocada.',
  },
];
---

<BaseLayout
  title="Nosotros"
  description={`${site.name} construye sitios rápidos, seguros y entregados en días. Manifiesto y filosofía.`}
  activePath={routes.sobre}
>
  <!-- HERO -->
  <section class="hero hero-short">
    <div class="container hero-inner">
      <span class="year">Nosotros</span>
      <span class="handle">Manifiesto</span>
      <Reveal>
        <h1>El código es <span class="muted">tuyo.</span></h1>
      </Reveal>
      <Reveal delay={0.15}>
        <p class="lead">
          En Panamá te venden WordPress lento, con el panel a nombre de la agencia y un código
          que nunca ves. Hacemos exactamente lo contrario.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- MANIFIESTO sobre la retícula de servidores -->
  <section class="manifest-scene">
    <SceneBg visual={sobreVisuals.manifiesto} side="center" dim={0.32} />
    <div class="container">
      <div class="manifest-list">
        {manifiesto.map((item, i) => (
          <Reveal delay={i * 0.08}>
            <article class="manifest-row">
              <span class="manifest-num">{item.num}</span>
              <div>
                <h2>{item.title}</h2>
                <p>{item.line}</p>
              </div>
            </article>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!--
    Pendiente de contenido del cliente: bio personal, foto profesional y
    credenciales. Hasta que existan, este bloque habla del estudio y de
    compromisos que ya están por escrito en /planes y /proceso — nada inventado.
  -->
  <section class="who-scene">
    <SceneBg visual={sobreVisuals.interfaz} side="left" dim={0.44} />
    <div class="container">
      <div class="who-copy">
        <Reveal>
          <span class="eyebrow">Quiénes</span>
          <h2 class="who-title">Hablas con <span class="muted">quien programa.</span></h2>
        </Reveal>

        <Reveal delay={0.12}>
          <p class="who-lead">
            Sin ejecutivos de cuenta. Sin intermediarios traduciendo lo que quieres. Sin tickets
            que tardan una semana en llegar a la persona correcta.
          </p>

          <ul class="who-points">
            <li><strong>Astro sobre CDN.</strong> Supabase solo si de verdad hace falta un CMS.</li>
            <li><strong>Precio y plazo cerrados</strong> antes de arrancar, no a mitad del proyecto.</li>
            <li><strong>100 % remoto</strong> para todo {site.location}, coordinado por WhatsApp ({contact.horario}).</li>
          </ul>

          <a class="btn btn-primary" href={waLink('Hola FLASK, quiero hablar de mi proyecto')} target="_blank" rel="noopener">
            <span class="dot"></span> Escribir directo
          </a>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>¿Trabajamos juntos?</h2>
        <p>Si compartes esta forma de ver la web, escríbenos. Empecemos con una cotización.</p>
        <a class="btn btn-primary" href={routes.contacto}>
          <span class="dot"></span> Contacto
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- MANIFIESTO ---------- */
  .manifest-scene {
    position: relative;
    padding: 120px 0;
    overflow: hidden;
  }
  .manifest-scene .container {
    position: relative;
    z-index: 1;
  }
  .manifest-list {
    position: relative;
    max-width: 78ch;
    margin: 0 auto;
  }
  /*
    Velo local en lugar de bajar el `dim` de toda la escena. El manifiesto es el
    único bloque con párrafos largos sobre imagen: apagar la retícula entera
    para asentarlo dejaba el fondo muerto. Así el texto queda sobre un fondo
    estable y la imagen sigue viva en los márgenes.
  */
  .manifest-list::before {
    content: '';
    position: absolute;
    inset: -60px -80px;
    z-index: -1;
    background: radial-gradient(
      ellipse 62% 58% at 50% 50%,
      rgba(16, 1, 1, 0.9) 0%,
      rgba(16, 1, 1, 0.72) 55%,
      rgba(16, 1, 1, 0) 100%
    );
    pointer-events: none;
  }
  .manifest-row {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 28px;
    align-items: baseline;
    padding: 34px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .manifest-list > :global(:first-child) .manifest-row {
    border-top: none;
    padding-top: 0;
  }
  .manifest-num {
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--flash-orange);
  }
  .manifest-row h2 {
    font-size: clamp(26px, 3.4vw, 42px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    text-shadow: 0 3px 30px rgba(16, 1, 1, 0.9);
  }
  .manifest-row p {
    font-size: 17px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.6;
    max-width: 62ch;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }

  /* ---------- QUIÉNES ---------- */
  .who-scene {
    position: relative;
    min-height: 84vh;
    display: flex;
    align-items: center;
    padding: 110px 0;
    overflow: hidden;
  }
  .who-scene .container {
    position: relative;
    z-index: 1;
  }
  .who-copy {
    max-width: 48ch;
  }
  .who-title {
    font-size: clamp(36px, 5.2vw, 66px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 26px;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .who-title .muted {
    color: var(--studio-gray);
  }
  .who-lead {
    font-size: 19px;
    color: var(--soft-white);
    line-height: 1.45;
    text-shadow: 0 2px 24px rgba(16, 1, 1, 0.9);
  }
  .who-points {
    list-style: none;
    margin: 30px 0 34px;
    display: grid;
    gap: 14px;
  }
  .who-points li {
    position: relative;
    padding-left: 22px;
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.55;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }
  .who-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--flash-orange);
  }
  .who-points strong {
    color: var(--soft-white);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .manifest-row {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 28px 0;
    }
    .who-scene {
      min-height: 0;
      padding: 84px 0;
    }
    .who-copy {
      max-width: none;
    }
  }
</style>
