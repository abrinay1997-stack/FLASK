---
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact, waLink, site } from '../data/site';
import { planOptions } from '../data/plans';
import { routes } from '../data/links';
---

<BaseLayout
  title="Contacto"
  description={`Cotiza tu sitio web con ${site.name}. Respuesta en menos de 24 horas. ${site.location}.`}
  activePath={routes.contacto}
>
  <!-- HERO -->
  <section class="hero hero-short">
    <div class="container hero-inner">
      <span class="year">Cotización</span>
      <span class="handle">Respuesta &lt; 24 h</span>
      <h1>Cotiza tu <span class="muted">sitio.</span></h1>
      <p class="lead">
        Cuéntanos qué necesitas. Te respondemos con una propuesta escrita que incluye alcance,
        cronograma y precio final. Sin sorpresas ni letra chica.
      </p>
    </div>
  </section>

  <!-- FORMULARIO + PANEL LATERAL -->
  <section style="padding-top:0;padding-bottom:60px;">
    <div class="container">
      <div class="contact-wrap">
        <!-- Formulario -->
        <div class="contact-form-card">
          <h2>Escríbenos</h2>
          <p class="form-lead">
            Los campos con <span style="color:var(--flash-orange);">*</span> son obligatorios. Al
            enviar se abre WhatsApp con tu mensaje ya redactado; solo tienes que darle a enviar.
            Nunca compartimos tus datos con terceros.
          </p>

          <!--
            Doble camino a propósito:

            · En Netlify, los atributos data-netlify hacen que el POST lo capture
              Netlify Forms y redirija a /gracias.
            · En GitHub Pages (el hosting actual) no hay backend que reciba el
              POST, así que el script del final intercepta el submit y arma un
              mensaje de WhatsApp con los datos del formulario.

            El primero es el camino nativo; el segundo es lo que está vivo hoy.
          -->
          <form
            name="contacto"
            method="POST"
            action={routes.gracias}
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            data-wa-fallback
            data-wa-number={contact.whatsappRaw}
            data-gracias={routes.gracias}
          >
            <input type="hidden" name="form-name" value="contacto" />
            <p class="honeypot">
              <label>No llenes este campo: <input name="bot-field" /></label>
            </p>

            <div class="field">
              <label for="nombre">Nombre <span class="req">*</span></label>
              <input id="nombre" name="nombre" type="text" required autocomplete="name" placeholder="Cómo te llamas" />
            </div>

            <div class="field">
              <label for="email">Correo <span class="req">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" placeholder="tunombre@correo.com" />
            </div>

            <div class="field">
              <label for="whatsapp">WhatsApp</label>
              <input id="whatsapp" name="whatsapp" type="tel" autocomplete="tel" placeholder="+507 6000 0000" />
            </div>

            <div class="field">
              <label for="plan">Plan de interés <span class="req">*</span></label>
              <select id="plan" name="plan" required>
                <option value="">Elige uno…</option>
                {planOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>

            <div class="field">
              <label for="mensaje">Cuéntanos sobre tu proyecto <span class="req">*</span></label>
              <textarea id="mensaje" name="mensaje" required placeholder="Qué haces, qué necesitas del sitio, si ya tienes uno actual, plazos…" />
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                <span class="dot"></span> Enviar por WhatsApp
              </button>
              <span class="form-note">
                ¿Prefieres escribir tú mismo?{' '}
                <a href={waLink()} target="_blank" rel="noopener">Abrir chat en blanco</a>
              </span>
            </div>
          </form>
        </div>

        <!-- Panel lateral -->
        <aside class="contact-side">
          <h3>Contacto directo</h3>
          <div class="prefer">Respuesta rápida por <span class="muted">WhatsApp.</span></div>

          <ul class="contact-list">
            <li>
              <span class="clabel">WhatsApp</span>
              <div class="cvalue">
                <a href={waLink()} target="_blank" rel="noopener">{contact.whatsapp}</a>
              </div>
              <div class="cmeta">Respondemos en horario laboral.</div>
            </li>
            <li>
              <span class="clabel">Horario</span>
              <div class="cvalue">{contact.horario}</div>
              <div class="cmeta">{contact.timezone}</div>
            </li>
            <li>
              <span class="clabel">Ubicación</span>
              <div class="cvalue">{site.location}</div>
              <div class="cmeta">Trabajamos 100 % en remoto para todo el país.</div>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  /** Prellena el <select> si la URL trae ?plan=… (los enlaces de /planes lo hacen). */
  function preselectPlan() {
    const plan = new URLSearchParams(location.search).get('plan');
    if (!plan) return;
    const sel = document.querySelector<HTMLSelectElement>('#plan');
    if (sel && [...sel.options].some((o) => o.value === plan)) sel.value = plan;
  }

  /**
   * GitHub Pages sirve archivos estáticos: no hay nada que reciba el POST del
   * formulario. En vez de dejarlo muerto, componemos un mensaje de WhatsApp con
   * lo que escribió la persona y lo abrimos listo para enviar.
   *
   * En Netlify no hace falta: ahí Netlify Forms captura el POST de verdad, así
   * que el handler se aparta y deja pasar el envío nativo.
   */
  function isNetlifyHost() {
    return /(^|\.)netlify\.(app|com)$/.test(location.hostname);
  }

  function buildWhatsAppMessage(form: HTMLFormElement) {
    const data = new FormData(form);
    const value = (name: string) => String(data.get(name) ?? '').trim();

    const planSelect = form.querySelector<HTMLSelectElement>('#plan');
    const planLabel = planSelect?.selectedOptions[0]?.textContent?.trim() || value('plan');

    const lines = [
      'Hola FLASK, quiero cotizar mi sitio web.',
      '',
      `Nombre: ${value('nombre')}`,
      `Correo: ${value('email')}`,
    ];
    if (value('whatsapp')) lines.push(`WhatsApp: ${value('whatsapp')}`);
    lines.push(`Plan de interés: ${planLabel}`, '', 'Proyecto:', value('mensaje'));
    return lines.join('\n');
  }

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('form[data-wa-fallback]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      if (isNetlifyHost()) return; // Netlify Forms se encarga

      event.preventDefault();

      // Honeypot: si un bot lo llenó, fingimos éxito y no abrimos nada
      const trap = form.querySelector<HTMLInputElement>('[name="bot-field"]');
      if (trap?.value) {
        location.href = form.dataset.gracias || '/';
        return;
      }

      const number = form.dataset.waNumber;
      if (!number) return;

      const url = `https://wa.me/${number}?text=${encodeURIComponent(buildWhatsAppMessage(form))}`;
      const tab = window.open(url, '_blank', 'noopener');

      if (tab) {
        // WhatsApp ya está abierto en otra pestaña: aquí mostramos el acuse
        location.href = form.dataset.gracias || '/';
      } else {
        // Bloqueador de pop-ups: navegamos en esta misma pestaña
        location.href = url;
      }
    });
  }

  function init() {
    preselectPlan();
    initContactForm();
  }

  document.addEventListener('astro:page-load', init);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
