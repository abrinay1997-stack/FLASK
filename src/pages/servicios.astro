---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import CineFrame from '../components/CineFrame.astro';
import { services } from '../data/services';
import { serviceVisuals } from '../data/images';
import { routes } from '../data/links';
---

<BaseLayout
  title="Servicios"
  description="Tres pilares: velocidad, seguridad y entrega en días. Así construye FLASK cada sitio web en Panamá."
  activePath={routes.servicios}
>
  <!-- HERO -->
  <section class="hero hero-short">
    <div class="container hero-inner">
      <span class="year">Servicios</span>
      <span class="handle">3 pilares</span>
      <Reveal>
        <h1>Tres ventajas <span class="muted">que la competencia no puede copiar.</span></h1>
      </Reveal>
      <Reveal delay={0.15}>
        <p class="lead">
          No vendemos "sitios bonitos". Vendemos velocidad medible, seguridad estructural y
          entrega en días. Cada pilar es una decisión técnica que la mayoría de agencias en
          Panamá no puede sostener.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- ESCENAS: una por servicio -->
  {services.map((s, i) => (
    <section class="service-scene" data-scene={s.idx}>
      <div class="container">
        <div class:list={['service-grid', { reverse: i % 2 === 1 }]}>
          <Reveal>
            <div class="service-body">
              <span class="service-idx">{s.idx} · Pilar</span>
              <h2>{s.title}</h2>
              <p class="service-short">{s.desc}</p>
              <p class="service-long">{s.longDesc}</p>
            </div>
          </Reveal>
          <Reveal delay={0.2}>
            <CineFrame
              class="service-visual"
              visual={serviceVisuals[s.idx]!}
              tag={s.idx}
              eager={i === 0}
              ratioMobile="16 / 10"
              sizes="(max-width: 900px) calc(100vw - 44px), 45vw"
            />
          </Reveal>
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>¿Listo para arrancar?</h2>
        <p>Elige el plan que se ajusta a tu negocio o cuéntanos qué necesitas y lo cotizamos.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={routes.planes}>
            <span class="dot"></span> Ver planes
          </a>
          <a class="btn btn-ghost" href={routes.contacto}>Escribirnos</a>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .service-scene {
    padding: 100px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .service-scene:first-of-type {
    padding-top: 60px;
    border-top: none;
  }
  .service-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .service-grid.reverse {
    grid-template-columns: 1fr 1.1fr;
  }
  /*
    Los hijos directos de la grid son los <div> que inyecta <Reveal>, no
    .service-body/.service-visual. El `order` tiene que ir sobre ellos, y con
    :global() porque no llevan el scope de esta página.
  */
  .service-grid.reverse > :global(:first-child) {
    order: 2;
  }
  .service-grid.reverse > :global(:last-child) {
    order: 1;
  }
  .service-idx {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 22px;
  }
  .service-body h2 {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 26px;
  }
  .service-short {
    font-size: 20px;
    font-weight: 400;
    color: var(--soft-white);
    margin-bottom: 22px;
    line-height: 1.4;
    max-width: 46ch;
  }
  .service-long {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    max-width: 60ch;
  }
  .service-grid :global(.service-visual) {
    max-height: 560px;
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .service-grid,
    .service-grid.reverse {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    /* En una sola columna el texto siempre va primero */
    .service-grid.reverse > :global(:first-child),
    .service-grid.reverse > :global(:last-child) {
      order: unset;
    }
    .service-grid :global(.service-visual) {
      max-height: 340px;
    }
  }
</style>
