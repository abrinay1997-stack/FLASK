---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import SceneBg from '../components/SceneBg.astro';
import { services } from '../data/services';
import { serviceVisuals } from '../data/images';
import { routes } from '../data/links';
---

<BaseLayout
  title="Servicios"
  description="Tres pilares: velocidad, seguridad y entrega en días. Así construye FLASK cada sitio web en Panamá."
  activePath={routes.servicios}
>
  <!-- HERO -->
  <section class="hero hero-short">
    <div class="container hero-inner">
      <span class="year">Servicios</span>
      <span class="handle">3 pilares</span>
      <Reveal>
        <h1>Tres ventajas <span class="muted">que la competencia no puede copiar.</span></h1>
      </Reveal>
      <Reveal delay={0.15}>
        <p class="lead">
          No vendemos "sitios bonitos". Vendemos velocidad medible, seguridad estructural y
          entrega en días. Cada pilar es una decisión técnica que la mayoría de agencias en
          Panamá no puede sostener.
        </p>
      </Reveal>
    </div>
  </section>

  <!--
    ESCENAS: la imagen es el fondo de la sección, no una pieza al lado del texto.
    El carril de lectura alterna de lado para que la página respire al bajar.
  -->
  {services.map((s, i) => {
    const side = i % 2 === 0 ? 'left' : 'right';
    return (
      <section class="service-scene" data-scene={s.idx} data-side={side}>
        <SceneBg visual={serviceVisuals[s.idx]!} side={side} dim={0.4} eager={i === 0} />
        <div class="container">
          <div class="service-copy">
            <Reveal>
              <span class="service-idx">{s.idx} · Pilar</span>
              <h2>{s.title}</h2>
            </Reveal>
            <Reveal delay={0.12}>
              <p class="service-short">{s.desc}</p>
            </Reveal>
            <Reveal delay={0.22}>
              <p class="service-long">{s.longDesc}</p>
            </Reveal>
          </div>
        </div>
      </section>
    );
  })}

  <!-- CTA -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>¿Listo para arrancar?</h2>
        <p>Elige el plan que se ajusta a tu negocio o cuéntanos qué necesitas y lo cotizamos.</p>
        <div class="cta-actions">
          <a class="btn btn-primary" href={routes.planes}>
            <span class="dot"></span> Ver planes
          </a>
          <a class="btn btn-ghost" href={routes.contacto}>Escribirnos</a>
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  .service-scene {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    padding: 120px 0;
    overflow: hidden;
  }
  .service-scene .container {
    position: relative;
    z-index: 1;
  }
  /* El texto ocupa poco menos de la mitad: el resto de la escena queda
     respirando con la imagen. */
  .service-copy {
    max-width: 46ch;
  }
  .service-scene[data-side='right'] .service-copy {
    margin-left: auto;
  }
  .service-idx {
    display: inline-block;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--flash-orange);
    margin-bottom: 20px;
  }
  .service-copy h2 {
    font-size: clamp(38px, 5.4vw, 68px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    margin-bottom: 26px;
    text-shadow: 0 4px 40px rgba(16, 1, 1, 0.85);
  }
  .service-short {
    font-size: 20px;
    font-weight: 400;
    color: var(--soft-white);
    margin-bottom: 22px;
    line-height: 1.4;
    text-shadow: 0 2px 24px rgba(16, 1, 1, 0.9);
  }
  .service-long {
    font-size: 16px;
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.65;
    text-shadow: 0 2px 20px rgba(16, 1, 1, 0.9);
  }
  .cta-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .service-scene {
      min-height: 0;
      padding: 90px 0;
    }
    .service-scene[data-side='right'] .service-copy {
      margin-left: 0;
    }
    .service-copy {
      max-width: none;
    }
  }
</style>
