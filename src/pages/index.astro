---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import HeroShader from '../components/HeroShader.astro';

import { site, waLink } from '../data/site';
import { plans } from '../data/plans';
import { services } from '../data/services';
import { routes } from '../data/links';
---

<BaseLayout
  title={`${site.name} — ${site.tagline} ${site.location}.`}
  description={site.description}
  activePath={routes.home}
>
  <!-- HERO CINEMÁTICO -->
  <section class="hero hero-cinematic" id="top">
    <HeroShader />

    <div class="container hero-inner">
      <span class="hero-eyebrow">Agencia web · {site.location}</span>
      <Reveal y={50}>
        <h1 class="hero-title">
          Sitios que <span class="ember">encienden</span>.<br />
          Código <span class="ember">tuyo</span>.
        </h1>
      </Reveal>
      <Reveal delay={0.2}>
        <p class="hero-lead">
          Diseñamos y programamos sitios Jamstack que cargan en menos de un segundo,
          entregados en días, con el código 100 % en tu propio GitHub. Desde $295.
        </p>
      </Reveal>
      <Reveal delay={0.35}>
        <div class="hero-actions">
          <a class="btn btn-primary" href={routes.planes}>
            <span class="dot"></span> Ver planes
          </a>
          <a class="btn btn-ghost" href={waLink()} target="_blank" rel="noopener">
            Hablar por WhatsApp
          </a>
        </div>
      </Reveal>
    </div>

    <a class="hero-scroll-cue" href="#servicios" aria-label="Ver servicios">
      <span>Scroll</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- PREVIEW SERVICIOS -->
  <section class="services" id="servicios">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Servicios</span>
          <Reveal>
            <h2 class="section-title">Tres pilares. <span class="muted">Cero atajos.</span></h2>
          </Reveal>
        </div>
        <Reveal delay={0.15}>
          <a class="section-link" href={routes.servicios}>
            Ver todo <span aria-hidden="true">→</span>
          </a>
        </Reveal>
      </div>
      <div class="service-list">
        {services.map((s) => (
          <Reveal>
            <a class="service-card" href={routes.servicios}>
              <span class="idx">{s.idx}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- PREVIEW PLANES -->
  <section class="planes-preview">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Planes</span>
          <Reveal>
            <h2 class="section-title">Precios fijos. <span class="muted">Cero letra chica.</span></h2>
          </Reveal>
        </div>
        <Reveal delay={0.15}>
          <a class="section-link" href={routes.planes}>
            Ver planes en detalle <span aria-hidden="true">→</span>
          </a>
        </Reveal>
      </div>
      <div class="plans-preview-grid">
        {plans.map((plan) => (
          <Reveal>
            <a class="plan-mini" href={routes.planes} data-featured={plan.featured}>
              {plan.featured && <span class="plan-mini-badge">Recomendado</span>}
              <div class="plan-mini-name">{plan.name.replace('Flask ', '')}</div>
              <div class="plan-mini-price">{plan.price}</div>
              <div class="plan-mini-delivery">{plan.delivery}</div>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  <!-- ARGUMENTO -->
  <section class="quote">
    <div class="container">
      <Reveal>
        <blockquote>
          El de $199 te entrega un WordPress <span class="muted">que carga en 5 segundos y que Google castiga.</span>
          Nosotros te entregamos un sitio que carga en menos de 1 segundo,
          <span class="muted">con el código en tu propio GitHub, en 5 días.</span>
        </blockquote>
        <div class="cite">— Argumento comercial, {site.name}</div>
      </Reveal>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta">
    <div class="container cta-inner">
      <Reveal>
        <h2>Tu sitio en 5 días.</h2>
        <p>
          Cuéntanos qué necesitas. Te enviamos un reporte PageSpeed de tu sitio actual y una
          propuesta escrita con alcance, cronograma y precio.
        </p>
        <a class="btn btn-primary" href={routes.contacto}>
          <span class="dot"></span> Ir al formulario
        </a>
      </Reveal>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- HERO CINEMÁTICO ---------- */
  .hero-cinematic {
    position: relative;
    min-height: 100vh;
    height: 100vh;
    max-height: 1080px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 100px 0 60px;
    overflow: hidden;
  }
  .hero-cinematic .hero-inner {
    position: relative;
    z-index: 2;
    max-width: 1280px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--studio-gray);
    margin-bottom: 32px;
    padding: 6px 14px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .hero-title {
    font-size: clamp(52px, 9vw, 132px);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-transform: none;
    max-width: 18ch;
    color: var(--soft-white);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
  }
  .hero-title .ember {
    color: var(--ember-red);
    font-style: italic;
    font-weight: 700;
  }
  .hero-lead {
    margin-top: 30px;
    max-width: 54ch;
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 300;
    color: var(--studio-gray);
    line-height: 1.5;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }
  .hero-actions {
    display: flex;
    gap: 14px;
    margin-top: 44px;
    flex-wrap: wrap;
  }

  /* Scroll indicator */
  .hero-scroll-cue {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--studio-gray);
    padding: 8px 12px;
  }
  .hero-scroll-cue:hover {
    color: var(--soft-white);
  }
  .hero-scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.5), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero-scroll-line::after {
    content: '';
    position: absolute;
    top: -36px;
    left: 0;
    width: 100%;
    height: 36px;
    background: linear-gradient(to bottom, transparent, var(--ember-red), transparent);
    animation: scroll-cue 2.2s ease-in-out infinite;
  }
  @keyframes scroll-cue {
    0% { transform: translateY(0); }
    100% { transform: translateY(72px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line::after { animation: none; opacity: 0.4; }
  }

  /* Ocultar el gradiente CSS antiguo (lo reemplaza el shader) */
  .hero-cinematic::after {
    display: none !important;
  }

  /* ---------- RESTO DE LA HOME ---------- */
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }
  .section-head h2.section-title { margin-bottom: 0; }
  .section-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--flash-orange);
    padding: 12px 20px;
    border: 1px solid rgba(255, 81, 0, 0.4);
    border-radius: 999px;
    transition: background 0.25s, border-color 0.25s;
    white-space: nowrap;
  }
  .section-link:hover {
    background: rgba(255, 81, 0, 0.1);
    border-color: var(--flash-orange);
  }
  .service-card { display: block; cursor: pointer; }

  .planes-preview { padding: 120px 0; }
  .plans-preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .plan-mini {
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.25s, transform 0.25s, background 0.25s;
    position: relative;
  }
  .plan-mini:hover {
    border-color: var(--flash-orange);
    transform: translateY(-4px);
    background: rgba(255, 81, 0, 0.04);
  }
  .plan-mini[data-featured='true'] {
    border-color: var(--flash-orange);
    background: linear-gradient(180deg, rgba(255, 81, 0, 0.1), rgba(255, 81, 0, 0) 60%);
  }
  .plan-mini-badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: var(--flash-orange);
    color: var(--deep-black);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 20px;
  }
  .plan-mini-name {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--studio-gray);
    margin-bottom: 12px;
  }
  .plan-mini-price {
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 6px;
  }
  .plan-mini-delivery {
    font-size: 12px;
    color: var(--flash-orange);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  @media (max-width: 900px) {
    .plans-preview-grid { grid-template-columns: repeat(2, 1fr); }
    .section-head { flex-direction: column; align-items: flex-start; gap: 20px; }
    .hero-cinematic { min-height: 90vh; height: auto; padding: 120px 0 100px; }
    .hero-title { font-size: clamp(44px, 12vw, 88px); }
  }
  @media (max-width: 640px) {
    .plans-preview-grid { grid-template-columns: 1fr; }
    .hero-eyebrow { font-size: 11px; padding: 5px 12px; }
  }
</style>
