---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routes } from '../data/links';
---

<BaseLayout title="Página no encontrada" noindex={true}>
  <main class="simple-page">
    <div class="simple-inner">
      <span class="simple-tag">Error 404</span>
      <h1>Esta página <br /><span style="color:var(--flash-orange);">no existe.</span></h1>
      <p>
        La dirección que buscabas no lleva a ningún lado. Puede que el enlace esté roto o que la
        página se haya movido. Volvamos a terreno conocido.
      </p>
      <div class="simple-actions">
        <a class="btn btn-primary" href={routes.home}>
          <span class="dot"></span> Volver al inicio
        </a>
        <a class="btn btn-ghost" href={routes.contacto}>Escribirnos</a>
      </div>
    </div>
  </main>
</BaseLayout>
