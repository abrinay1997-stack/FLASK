---
/**
 * Reveal por scroll con estrategia robusta.
 *
 * - CSS transitions puros (más confiables que animations en browsers pausados).
 * - Above-the-fold: se revela inmediatamente al cargar.
 * - Below-the-fold: IntersectionObserver, uno compartido por todos los nodos.
 * - Fallback CSS con animation-fill si nada dispara (1.5s).
 * - Respeta prefers-reduced-motion.
 *
 * Antes esto lo disparaba ScrollTrigger de GSAP y el IntersectionObserver era el
 * plan B. Se invirtió: el plan B hacía el mismo trabajo con la API del navegador
 * y GSAP costaba 43 KB comprimidos en las doce páginas. El observador no es un
 * apaño — es más barato, no necesita `refresh()` tras cambiar el DOM y no hay
 * que matarlo al navegar.
 */

interface Props {
  as?: string;
  delay?: number;
  y?: number;
  duration?: number;
  stagger?: boolean;
  class?: string;
}

const {
  as: Tag = 'div',
  delay = 0,
  y = 24,
  duration = 0.9,
  stagger = false,
  class: className = '',
} = Astro.props;

const classes = ['reveal', stagger ? 'reveal--stagger' : '', className].filter(Boolean).join(' ');
const styleVars = `--reveal-delay:${delay}s;--reveal-duration:${duration}s;--reveal-y:${y}px;`;
---

<Tag
  class={classes}
  data-reveal
  style={styleVars}
>
  <slot />
</Tag>

<script>
  import { prefersReducedMotion } from '../scripts/motion';

  /**
   * Un solo observador para todos los nodos de la página, no uno por nodo: el
   * navegador agrupa las entradas en una sola callback y no hay que acordarse de
   * desconectar nada. `-12%` del borde inferior equivale al `top 88%` que
   * disparaba antes ScrollTrigger, así que el momento del reveal no cambia.
   */
  let observer: IntersectionObserver | null = null;

  function markDone(el: HTMLElement) {
    el.setAttribute('data-reveal-done', '');
  }

  function getObserver(): IntersectionObserver {
    if (observer) return observer;
    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          markDone(entry.target as HTMLElement);
          observer!.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' }
    );
    return observer;
  }

  function initReveals() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-reveal-done])');
    if (!nodes.length) return;

    if (prefersReducedMotion()) {
      nodes.forEach(markDone);
      return;
    }

    const vh = window.innerHeight || document.documentElement.clientHeight || 720;
    const io = getObserver();

    nodes.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const aboveTheFold = rect.top < vh * 0.9 && rect.bottom > 0;

      if (aboveTheFold) {
        // Marcar done ya — transition CSS anima suavemente
        markDone(el);
      } else {
        io.observe(el);
      }
    });
  }

  document.addEventListener('astro:page-load', initReveals);
  document.addEventListener('astro:after-swap', initReveals);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveals, { once: true });
  } else {
    initReveals();
  }
</script>

<style is:global>
  /* Transitions puros: valores finales se aplican SIEMPRE, animación es enhancement */
  [data-reveal] {
    opacity: 0;
    transform: translate3d(0, var(--reveal-y, 24px), 0);
    transition:
      opacity var(--reveal-duration, 0.9s) cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s),
      transform var(--reveal-duration, 0.9s) cubic-bezier(0.22, 1, 0.36, 1) var(--reveal-delay, 0s);
    will-change: transform, opacity;
    /* Fallback duro: si nada dispara en 1.5s, forzar visible via CSS animation */
    animation: reveal-fallback 0.7s ease-out 1.5s forwards;
  }
  [data-reveal-done] {
    opacity: 1;
    transform: none;
    will-change: auto;
    animation: none;
  }
  @keyframes reveal-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
  }
</style>
