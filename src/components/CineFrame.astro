---
/**
 * Marco cinemático reutilizable para las imágenes de Stitch.
 *
 * Recorta al aspect ratio que le pidan, aplica el degradado de marca por
 * encima (para que la imagen nunca compita con el texto) y deja un borde y
 * radio consistentes con las tarjetas del sitio.
 *
 * La imagen se procesa con `astro:assets`: el PNG de ~1.3 MB sale como WebP
 * responsive de decenas de kB.
 */
import { Image } from 'astro:assets';
import type { Visual } from '../data/images';

interface Props {
  visual: Visual;
  /** CSS aspect-ratio del marco, p. ej. '1 / 1' o '21 / 9'. */
  ratio?: string;
  /**
   * Aspect ratio bajo 900 px. Va aquí y no en la página porque `--ratio` se
   * escribe inline: un override desde una media query externa perdería.
   */
  ratioMobile?: string;
  /** `sizes` del <img>: cuánto ancho de viewport ocupa realmente el marco. */
  sizes?: string;
  widths?: number[];
  /** Solo para imágenes above-the-fold. */
  eager?: boolean;
  /** Rótulo grande sobre la imagen (el índice del pilar, por ejemplo). */
  tag?: string;
  class?: string;
}

const {
  visual,
  ratio = '1 / 1',
  ratioMobile,
  sizes = '(max-width: 900px) 100vw, 45vw',
  widths = [480, 768, 1080, 1440],
  eager = false,
  tag,
  class: className = '',
} = Astro.props;
---

<figure
  class:list={['cine', className]}
  style={`--ratio:${ratio};--ratio-m:${ratioMobile ?? ratio};--focus:${visual.focus ?? 'center center'}`}
>
  <Image
    src={visual.src}
    alt={visual.alt}
    widths={widths}
    sizes={sizes}
    format="webp"
    quality={70}
    loading={eager ? 'eager' : 'lazy'}
    decoding={eager ? 'sync' : 'async'}
    {...(eager ? { fetchpriority: 'high' as const } : {})}
  />
  <span class="cine-wash" aria-hidden="true"></span>
  {tag && <span class="cine-tag" aria-hidden="true">{tag}</span>}
</figure>

<style>
  .cine {
    position: relative;
    aspect-ratio: var(--ratio, 1 / 1);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--deep-black);
    isolation: isolate;
  }
  .cine :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, center center);
    display: block;
    /* La imagen entra apagada y sube al hover del contenedor padre */
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cine:hover :global(img) {
    transform: scale(1.03);
  }
  /* Baño de marca: liga la foto al naranja del sistema y hunde las esquinas */
  .cine-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(16, 1, 1, 0.05) 0%, rgba(16, 1, 1, 0.55) 100%),
      radial-gradient(120% 90% at 20% 10%, rgba(255, 81, 0, 0.16), transparent 60%);
  }
  .cine-tag {
    position: absolute;
    left: 22px;
    bottom: 14px;
    font-size: clamp(56px, 8vw, 104px);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--soft-white);
    mix-blend-mode: overlay;
    opacity: 0.9;
  }
  @media (max-width: 900px) {
    .cine {
      aspect-ratio: var(--ratio-m, var(--ratio, 1 / 1));
    }
    .cine-tag {
      left: 18px;
      bottom: 10px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cine:hover :global(img) {
      transform: none;
    }
  }
</style>
