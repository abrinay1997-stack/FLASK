---
import type { Plan } from '../data/plans';
import { routes } from '../data/links';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
// Se compone de `routes.contacto`, no de una ruta escrita a mano: así el día
// que cambie el formato de URL —como pasó al quitar los `.html`— este enlace
// cambia solo.
const cotizarHref = `${routes.contacto}?plan=${plan.slug}`;
---

<div class:list={['plan', { featured: plan.featured }]}>
  {plan.badge && <span class="badge">{plan.badge}</span>}
  <div class="plan-name"><strong>{plan.name}</strong></div>
  <div class="price">{plan.price}</div>
  <div class="delivery">{plan.delivery}</div>
  <p class="desc">{plan.desc}</p>
  <ul>
    {plan.features.map((f) => <li>{f}</li>)}
  </ul>
  <a class="plan-cta" href={cotizarHref}>Cotizar {plan.name.replace('CuatroNodos ', '')}</a>
</div>
